{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenPlan",
  "version": "0.3.0",
  "identifier": "com.siddeshsambasivam.openplan",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build && pnpm run build:sidecar",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenPlan",
        "width": 1160,
        "height": 760,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 27
        },
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "**"
          ],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Manage the plans you build with your coding agents",
    "longDescription": "OpenPlan is one place to manage all the plans you and your coding agents collaborate on. Agents from Claude Code, Codex, and Cursor file plans into a local, version-controlled plan base; you read, comment, and approve.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/openplan"
    ]
  },
  "mainBinaryName": "openplan-app"
}
