{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenMarkdown",
  "version": "0.1.0",
  "identifier": "com.siddeshsambasivam.openmarkdown",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenMarkdown",
        "width": 1160,
        "height": 760,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "A minimal, elegant Markdown viewer",
    "longDescription": "OpenMarkdown is a fast, minimal, cross-platform viewer for Markdown files. No vaults, no projects — just open a file and read.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
